// Grass wind SIMULATION: a camera-centred, toroidal 128x128 grid (one cell per 2x2
// world columns) of damped springs. Each cell's bend is pulled toward the local wind
// force and overshoots / settles like real grass (underdamped: damping ratio ~0.3,
// ~0.9 Hz, varied per cell so neighbours never move in lockstep).
//
// The force is a smooth field: a slowly turning wind direction, a breeze, gust fronts
// (fbm) travelling downwind at r.wind.speed, and small turbulence. The CPU passes this
// frame's real time step split into equal substeps of <= 1/120 s (semi-implicit Euler),
// so the motion is the same at 30, 60 or 240 fps.
//
// windDisp = (bend now .xy, bend at the end of last frame .zw) — grass.glsl reads
// both (motion vectors); windVel = (velocity .xy, SET .zw). Updated in place: a cell
// only touches its own texel. Cells that scrolled into the grid this frame (camera
// moved) start at rest at their equilibrium bend.
//
// SET (lingering tilt): grass is viscoelastic — held bent it creeps and keeps part of
// the bend after the wind drops, then slowly straightens. The spring's rest shifts by
// `set`, which creeps toward setStrength x the elastic bend (bend - set) with time
// constant `recover` (so a steady breeze leans grass (1 + setStrength) x as far, and a
// calm lets it recover over ~recover seconds).
// TRAMPLE (windTrample = flatten direction .xy, amount .z): stampers (the walking
// camera, bodies on the ground) push it to 1 inside their footprint, pointing away
// from their centre; it relaxes with the same recover time.

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba16f, SET(3) binding = 0) uniform image2D windDispImg;
layout(rgba16f, SET(3) binding = 1) uniform image2D windVelImg;
layout(rgba16f, SET(3) binding = 2) uniform image2D windTrampleImg;

layout(push_constant) uniform PC {
    ivec2 origin;       // world wind-cell of grid texel (0,0) this frame (camera-centred)
    ivec2 prevOrigin;   // ... last frame
    float t0;           // time at the start of this frame's step
    float h;            // substep length (s)
    int nSteps;         // substeps this frame (0 = time frozen)
    int reset;          // 1 = (re)start every cell at rest
    float strength;     // r.wind.strength
    float gust;         // r.wind.gust
    float speed;        // r.wind.speed (voxels / s)
    float dirRad;       // r.wind.dir
    float setStrength;  // r.wind.set
    float recover;      // r.grass.recover (s)
    float pad0, pad1;
    vec4 stamp[4];      // xz (.x, .z), radius .w (0 = none); .y unused
} pc;

const int kRes = 128;
const float kCell = 2.0;

float wHash(vec2 p) {
    p = fract(p * vec2(0.1031, 0.1030));
    p += dot(p, p.yx + 33.33);
    return fract((p.x + p.y) * p.x);
}
float wNoise(vec2 p) {
    vec2 i = floor(p), f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(wHash(i), wHash(i + vec2(1, 0)), f.x),
               mix(wHash(i + vec2(0, 1)), wHash(i + vec2(1, 1)), f.x), f.y);
}
float wFbm(vec2 p) { return 0.55 * wNoise(p) + 0.3 * wNoise(p * 2.1 + 7.3) + 0.15 * wNoise(p * 4.3 - 3.1); }

// Wind force at world xz, time t, in bend units (the bend a cell settles at).
// (src/wind_field.h evaluates the same gusts on the CPU for the wind sound: keep them in sync.)
vec2 windForce(vec2 xz, float t) {
    float ang = pc.dirRad + 0.35 * sin(t * 0.043) + 0.2 * sin(t * 0.017 + 1.3);
    vec2 dir = vec2(cos(ang), sin(ang));
    // Gust fronts: fbm scrolling downwind; remapped so strong gusts are occasional.
    float n = wFbm(xz * 0.03 - dir * (t * pc.speed * 0.03));
    float gust = smoothstep(0.42, 0.85, n) * pc.gust;
    float breeze = 0.3 + 0.25 * wNoise(xz * 0.08 + t * 0.2);
    vec2 turb = vec2(wNoise(xz * 0.3 + vec2(t * 1.3, 0.0)), wNoise(xz * 0.3 - vec2(0.0, t * 1.1) + 9.0)) - 0.5;
    return pc.strength * (dir * (breeze + 1.6 * gust) + turb * 0.35);
}

void main() {
    ivec2 tx = ivec2(gl_GlobalInvocationID.xy);
    if (tx.x >= kRes || tx.y >= kRes) return;
    // The world cell this texel holds now: the one in [origin, origin + kRes) that is
    // congruent to tx (mod kRes).
    ivec2 cell = pc.origin + ((tx - pc.origin) & (kRes - 1));
    vec2 xz = (vec2(cell) + 0.5) * kCell;
    bool fresh = pc.reset != 0 || any(lessThan(cell, pc.prevOrigin)) ||
                 any(greaterThanEqual(cell, pc.prevOrigin + kRes));
    vec4 dv = imageLoad(windDispImg, tx);
    vec2 d = dv.xy;
    vec4 vs = imageLoad(windVelImg, tx);
    vec2 v = vs.xy, sset = vs.zw;
    vec4 tr = imageLoad(windTrampleImg, tx);
    if (fresh) { d = windForce(xz, pc.t0); v = vec2(0.0); sset = d * pc.setStrength; d += sset; tr = vec4(0.0); }
    vec2 dPrev = d;
    // Per-cell natural frequency 0.75-1.05 Hz, damping ratio 0.3.
    float omega = 6.2831853 * mix(0.75, 1.05, wHash(vec2(cell) * 0.37 + 5.1));
    float k = omega * omega, c = 2.0 * 0.3 * omega;
    float relax = 1.0 / max(pc.recover, 0.5);
    for (int i = 0; i < pc.nSteps; i++) {
        vec2 f = windForce(xz, pc.t0 + pc.h * float(i + 1));
        v += (k * (f + sset - d) - c * v) * pc.h;
        d += v * pc.h;
        sset += (pc.setStrength * (d - sset) - sset) * (pc.h * relax);
    }
    // Trampling: footprint -> flattened (away from the stamper's centre); relaxes.
    float dtFrame = pc.h * float(pc.nSteps);
    tr.xyz *= exp(-dtFrame * relax);
    for (int s = 0; s < 4; s++) {
        if (pc.stamp[s].w <= 0.0) continue;
        vec2 o = xz - pc.stamp[s].xz;
        float r = pc.stamp[s].w;
        float a = 1.0 - smoothstep(r * 0.6, r + kCell, length(o));
        if (a > tr.z) {
            vec2 dir = length(o) > 1e-3 ? normalize(o) : vec2(1.0, 0.0);
            tr = vec4(dir * a, a, 0.0);
        }
    }
    imageStore(windDispImg, tx, vec4(d, dPrev));
    imageStore(windVelImg, tx, vec4(v, sset));
    imageStore(windTrampleImg, tx, tr);
}
