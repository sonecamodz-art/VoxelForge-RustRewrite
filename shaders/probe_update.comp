// Standard lighting: blend this frame's probe rays into the probe atlases
// (irradiance 8x8 + depth moments 16x16 octahedral tiles) with hysteresis, then
// write each tile's 1-texel border (octahedral wrap) so bilinear sampling works.
// One 16x16 workgroup per updated probe.

layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba32f, SET(3) binding = 0) uniform image2D probeIrr;
layout(rg32f,   SET(3) binding = 1) uniform image2D probeDepth;
layout(r32ui,   SET(3) binding = 2) uniform uimage2D probeState;
layout(SET(3) binding = 3) uniform sampler2D probeRays;
layout(rgba16f, SET(3) binding = 4) uniform image2D probeData;   // offset xyz, state w

// This frame's probe update list (LitRenderer: new cells first, then round robin).
layout(std140, SET(3) binding = 5) uniform ProbeList { uvec4 probeList[1280]; };

BEGIN_PASS_UNIFORMS
PASS_UNIFORMS_BODY
END_PASS_UNIFORMS

// RTXGI defaults-style thresholds, in the encoded (pow 1/5) space.
const float kIrrChangeThreshold = 0.25;
const float kIrrBrightnessThreshold = 0.5;

shared vec3 sDir[kProbeRays];
shared vec4 sRay[kProbeRays];
shared vec3 sIrr[kIrrN * kIrrN];
shared vec2 sDep[kDepN * kDepN];

// Interior texel feeding border texel b of an n-wide tile (1-texel border).
ivec2 borderSource(ivec2 b, int n) {
    bool cx = b.x == 0 || b.x == n + 1, cy = b.y == 0 || b.y == n + 1;
    if (cx && cy) return ivec2(b.x == 0 ? n - 1 : 0, b.y == 0 ? n - 1 : 0);
    if (cy) return ivec2(n - b.x, b.y == 0 ? 0 : n - 1);
    return ivec2(b.x == 0 ? 0 : n - 1, n - b.y);
}

void main() {
    int t = int(gl_LocalInvocationIndex);
    int row = int(gl_WorkGroupID.x);
    int L; ivec3 slot, cell;
    probeFromEntry(probeList[row >> 2][row & 3], L, slot, cell);
    const float spL = lvSpacing(L);
    if (t < kProbeRays) {
        sRay[t] = texelFetch(probeRays, ivec2(t, row), 0);
        sDir[t] = probeRayDir(t, frameIdx);
    }
    barrier();
    ivec2 sc = probeStateCoord(probeIndex(L, slot));
    uint key = probeKey(L, cell);
    bool fresh = imageLoad(probeState, sc).r != key || probeResettle(probeList[row >> 2][row & 3]);
    vec4 pd = fresh ? vec4(0.0, 0.0, 0.0, 1.0) : imageLoad(probeData, sc);
    // State w: 1..9 active (settling count, 9 = settled), <= 0 disabled: -k = found
    // enclosed k times. A disabled probe is re-tested (the random ray rotation or an
    // edit may free it) up to kMaxRetries times, then stays off until its cell leaves
    // the grid — a borderline probe no longer blinks on and off every update.
    const float kMaxRetries = 6.0;
    bool wasOff = !fresh && pd.w < 0.5;
    barrier();   // every thread has read probeData before thread 0 rewrites it below
    const float maxOff = 0.45 * spL;
    if (sRay[0].a < -1.5) return;   // a body covers the probe right now: keep its light
    if (sRay[0].a < 0.0) {
        // Buried: disable and try a random nearby position next time (the search
        // is stateless: a new hash every update until a free spot is found).
        if (t == 0) {
            uint hh = pcgHash(uint(probeIndex(L, slot)) * 9781u + frameIdx);
            vec3 rnd3 = vec3(float(hh & 1023u), float((hh >> 10) & 1023u), float((hh >> 20) & 1023u)) / 1023.0;
            imageStore(probeData, sc, vec4((rnd3 * 2.0 - 1.0) * maxOff, 0.0));
            imageStore(probeState, sc, uvec4(key));   // own the cell (offset kept)
        }
        return;
    }
    if (wasOff && pd.w <= -kMaxRetries) return;   // given up: stays disabled
    // New cell, or a probe coming back from disabled / relocation: its tiles hold
    // another cell's (or stale) light -> no history.
    float hyst = (fresh || wasOff) ? 0.0 : probeHyst;
    if (t == 0) {
        // Relocation + classification (DDGI), only while the probe SETTLES (its first
        // 8 updates in this cell; pd.w counts them, 9 = settled): push it away from
        // the closest hit; if a quarter of its rays hit almost immediately it is
        // enclosed (inside a leaf clump / wall gap) and would only smear darkness,
        // so disable it. Afterwards it never moves or flips again (a probe that
        // keeps moving makes the light on nearby walls breathe).
        float settle = pd.w;
        if (settle < 8.5) {
            float closest = 1e9; vec3 cdir = vec3(0.0); int nNear = 0;
            for (int r = 0; r < kProbeRays; r++) {
                float d = sRay[r].a;
                if (d < closest) { closest = d; cdir = sDir[r]; }
                if (d < 0.15 * spL) nNear++;
            }
            vec3 off = pd.xyz;
            if (closest < maxOff) off = clamp(off - cdir * (maxOff - closest) * 0.5, vec3(-maxOff), vec3(maxOff));
            // Enter "enclosed" above 25 % near hits, leave it only below 15 % (hysteresis).
            bool enclosed = wasOff ? nNear > (kProbeRays * 15) / 100 : nNear > kProbeRays / 4;
            settle = enclosed ? min(settle, 0.0) - 1.0 : max(settle, 1.0) + 1.0;
            imageStore(probeData, sc, vec4(off, settle));
        }
    }
    ivec2 tile = probeTile(L, slot);
    ivec2 lid = ivec2(gl_LocalInvocationID.xy);
    const float maxD = spL * 1.5;

    if (lid.x < kIrrN && lid.y < kIrrN) {    // irradiance: cosine-weighted mean radiance
        vec3 dir = octDecode(((vec2(lid) + 0.5) / float(kIrrN)) * 2.0 - 1.0);
        vec3 acc = vec3(0.0);
        float ws = 0.0;
        for (int r = 0; r < kProbeRays; r++) {
            float w = max(dot(dir, sDir[r]), 0.0);
            acc += sRay[r].rgb * w;
            ws += w;
        }
        vec3 v = ws > 1e-4 ? acc / ws : vec3(0.0);
        ivec2 px = tile * (kIrrN + 2) + 1 + lid;
        vec3 prev = imageLoad(probeIrr, px).rgb;
        float h = hyst;
        if (h > 0.0) {
            // RTXGI probe blending: a large change (sun moved, wall carved) drops the
            // hysteresis so the probe catches up in a few updates instead of ~30; a
            // single bright outlier (one ray on an emissive) moves it only a quarter.
            // Judged in the perceptual (encoded) space, applied linearly.
            vec3 d = irrEncode(v) - irrEncode(prev);
            if (max(max(abs(d.x), abs(d.y)), abs(d.z)) > kIrrChangeThreshold) h = max(0.0, h - 0.75);
            if (length(d) > kIrrBrightnessThreshold) v = prev + (v - prev) * 0.25;
        }
        sIrr[lid.y * kIrrN + lid.x] = mix(v, prev, h);
    }
    {                                        // depth moments (sharper lobe)
        vec3 dir = octDecode(((vec2(lid) + 0.5) / float(kDepN)) * 2.0 - 1.0);
        vec2 acc = vec2(0.0);
        float ws = 0.0;
        for (int r = 0; r < kProbeRays; r++) {
            float w = pow(max(dot(dir, sDir[r]), 0.0), 50.0);
            float d = min(sRay[r].a, maxD);
            acc += vec2(d, d * d) * w;
            ws += w;
        }
        vec2 v = ws > 1e-4 ? acc / ws : vec2(maxD, maxD * maxD);
        ivec2 px = tile * (kDepN + 2) + 1 + lid;
        vec2 prev = imageLoad(probeDepth, px).rg;
        sDep[lid.y * kDepN + lid.x] = mix(v, prev, hyst);
    }
    barrier();
    // Interior + border writes from shared memory.
    for (int i = t; i < (kIrrN + 2) * (kIrrN + 2); i += 256) {
        ivec2 b = ivec2(i % (kIrrN + 2), i / (kIrrN + 2));
        bool border = b.x == 0 || b.y == 0 || b.x == kIrrN + 1 || b.y == kIrrN + 1;
        ivec2 s = border ? borderSource(b, kIrrN) : b - 1;
        imageStore(probeIrr, tile * (kIrrN + 2) + b, vec4(sIrr[s.y * kIrrN + s.x], 1.0));
    }
    for (int i = t; i < (kDepN + 2) * (kDepN + 2); i += 256) {
        ivec2 b = ivec2(i % (kDepN + 2), i / (kDepN + 2));
        bool border = b.x == 0 || b.y == 0 || b.x == kDepN + 1 || b.y == kDepN + 1;
        ivec2 s = border ? borderSource(b, kDepN) : b - 1;
        imageStore(probeDepth, tile * (kDepN + 2) + b, vec4(sDep[s.y * kDepN + s.x], 0.0, 0.0));
    }
    if (t == 0) imageStore(probeState, sc, uvec4(key));
}
