// Standard lighting (r.lighting standard): the noise-free counterpart of
// raw_shade.comp. Same G-buffer and shading model (shadeSurface), but the sun
// shadow is ONE deterministic traced ray per pixel softened in screen space
// (shadow_trace.comp + shadow_soften.comp: exact at any distance, nothing to pop),
// and the indirect light comes from the probe grid instead of a GI ray. No
// per-pixel noise, so no denoiser: the result goes straight to DLAA / DLSS-SR.

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba16f, SET(3) binding = 0) uniform writeonly image2D outColor;   // HDR linear
layout(SET(3) binding = 2) uniform sampler2D gbAlbedo;
layout(SET(3) binding = 3) uniform sampler2D gbNormal;
layout(SET(3) binding = 4) uniform sampler2D gbPos;
layout(SET(3) binding = 5) uniform sampler2D fogTex;
layout(SET(3) binding = 14) uniform sampler3D froxelVol;   // integrated froxel fog (r.fog.method froxel)
layout(SET(3) binding = 6) uniform sampler2D sunShadow;   // traced + softened (shadow_*.comp)
#ifdef WATER_CLEAR
layout(SET(3) binding = 20) uniform sampler2D cloudHalf;  // clouds.comp (half res)
layout(SET(3) binding = 16) uniform sampler2D gbDelta;    // .a = body + 1 (self-occlusion)
layout(SET(3) binding = 17) uniform sampler2D lampTex;    // lamp_std.comp (full or half res)
layout(SET(3) binding = 12) uniform sampler2D gbWater;    // in-water path, bed depth (gbuffer.comp)
#endif
#if defined(WATER_CLEAR) || defined(REFL_GLOSSY)   // (also glossy surfaces' reflections)
layout(SET(3) binding = 13) uniform sampler2D waterAdd;   // reflection + glint + in-scatter (water_refl.comp)
#endif

layout(SET(3) binding = 18) uniform sampler2D gbSurf;     // roughness, metalness, bump (gbuffer.comp)

BEGIN_PASS_UNIFORMS
PASS_UNIFORMS_BODY
END_PASS_UNIFORMS

// Lamp light at a pixel: lamp_std's own texel, or (r.lights.quality half) the 4 nearest
// half-res samples (each taken at its block's top-left pixel) weighted bilinearly x
// same plane x same normal, so light never bleeds across an edge.
vec3 lampAt(ivec2 pix, vec3 P, vec3 N) {
#ifndef LIGHTS_NEE
    return vec3(0.0);
#elif !defined(LIGHTS_HALF)
    return texelFetch(lampTex, pix, 0).rgb;
#else
    ivec2 res = textureSize(gbPos, 0);
    ivec2 hres = (res + 1) / 2;
    vec2 hp = vec2(pix) * 0.5;               // position in half-res sample units
    ivec2 q0 = ivec2(floor(hp));
    vec2 f = hp - vec2(q0);
    vec3 acc = vec3(0.0);
    float wsum = 0.0;
    for (int k = 0; k < 4; k++) {
        ivec2 d = ivec2(k & 1, k >> 1);
        ivec2 q = min(q0 + d, hres - 1);
        ivec2 sp = min(q * 2, res - 1);
        vec4 pq = texelFetch(gbPos, sp, 0);
        if (pq.w < 0.0) continue;
        vec3 nq = texelFetch(gbNormal, sp, 0).xyz * 2.0 - 1.0;
        float wb = (d.x == 1 ? f.x : 1.0 - f.x) * (d.y == 1 ? f.y : 1.0 - f.y) + 1e-3;
        float wp = exp(-abs(dot(pq.xyz - P, N)) * 4.0);
        float wn = pow(max(dot(nq, N), 0.0), 8.0);
        float w = wb * wp * wn;
        acc += texelFetch(lampTex, q, 0).rgb * w;
        wsum += w;
    }
    return wsum > 1e-4 ? acc / wsum : texelFetch(lampTex, min(q0, hres - 1), 0).rgb;
#endif
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 res = imageSize(outColor);
    // No early return before voxelAOFarQuad: its quad ops need every lane.
    bool inb = pix.x < res.x && pix.y < res.y;
    pix = min(pix, res - 1);
    float aspect = float(res.x) / float(res.y);
    vec2 ndc = (vec2(pix) + 0.5) / vec2(res) * 2.0 - 1.0;
    vec3 rd = normalize(camFwd + camRight * (ndc.x * aspect * tanHalfFov) +
                        camUp * (ndc.y * tanHalfFov));
    vec4 posT = texelFetch(gbPos, pix, 0);
    bool sky = posT.w < 0.0;
    gSelfBody = selfBodyOf(texelFetch(gbDelta, pix, 0).a);
    float farAO = voxelAOFarQuad(posT.xyz, texelFetch(gbNormal, pix, 0).xyz * 2.0 - 1.0, inb && !sky);
    if (!inb) return;
    vec3 base;
    if (sky) {
        base = skyColor(rd);
#ifdef WATER_CLEAR
        {   // seen from under water: through the water up to the surface, plus its murk
            vec4 wv = texelFetch(gbWater, pix, 0);
            if (wv.x > 0.0 && wv.y < 0.0) {
                gWaterClarity = waterP.x; gWaterMurk = underP.y; gWave = waveP;
                // Through Snell's window: gbuffer.comp left the refracted direction in gbNormal.
                vec4 nd = texelFetch(gbNormal, pix, 0);
                if (dot(nd.xyz, nd.xyz) > 0.0) base = skyColor(normalize(nd.xyz * 2.0 - 1.0));
                base = base * waterTrans(wv.x) + texelFetch(waterAdd, pix, 0).rgb;
            }
        }
#endif
    } else {
        vec3 P = posT.xyz;
        vec3 N = texelFetch(gbNormal, pix, 0).xyz * 2.0 - 1.0;
        N = facetNormal(N, texelFetch(gbSurf, pix, 0));   // (per-voxel facets, gbuffer.comp)
        vec4 alb = texelFetch(gbAlbedo, pix, 0);
#ifdef WATER_CLEAR   // under water the sun arrives refracted (common.glsl sunDirWater)
        float ndl = max(dot(N, waterLightDepth(texelFetch(gbWater, pix, 0)) > 0.0 ? sunDirWater() : sunDir), 0.0);
#else
        float ndl = max(dot(N, sunDir), 0.0);
#endif
        float shadow = 0.0;
        bool leaf = false;
#ifdef FOLIAGE_SSS
        leaf = isFoliageFlag(texelFetch(gbNormal, pix, 0).a);   // back-lit foliage has a sun term too
#endif
        if (ndl > 0.0 || leaf) {
            // Exact traced sun visibility (incl. moving bodies + grass blades),
            // softened in screen space by the blocker distance: no cascades, no pop.
            shadow = texelFetch(sunShadow, pix, 0).r;
        }
        vec3 indirect = probeIrradiance(P, N, -rd) * (0.3 + 0.7 * farAO);
#ifdef LIGHTS_NEE
        indirect += lampAt(pix, P, N);   // lamps / glowing bodies (the probes skip them)
#endif
        float contact = 0.55 + 0.45 * voxelAO(P, N);
        bool water = texelFetch(gbNormal, pix, 0).a < 0.5;
#ifdef FOLIAGE_SSS
        { float fa = texelFetch(gbNormal, pix, 0).a; gFoliage = isFoliageFlag(fa) ? 1.0 : 0.0; gSss = lookP.x; }
#endif
#ifdef WATER_CLEAR
        // Under water: less sun / sky reaches the bed (its view absorption is in alb).
        gWaterClarity = waterP.x; gWaterMurk = underP.y; gWave = waveP;
        { vec4 wv = texelFetch(gbWater, pix, 0); setWaterLightAt(waterLightDepth(wv), P, time, underP.z); }   // + caustics
#endif
        setSurface(texelFetch(gbSurf, pix, 0));
        base = shadeSurface(P, N, rd, alb, water, ndl, shadow, indirect, contact);
#if defined(WATER_CLEAR) || defined(REFL_GLOSSY)
        base += texelFetch(waterAdd, pix, 0).rgb;
#endif
        // r.debugview (same indices as the traced path; written pre-exposure, so the
        // tonemap shows them roughly like denoise.comp's direct display values).
        if (debugMode == DV_CASCADE) {   // cascade rings (blend band = mixed colours)
            const vec3 cc[4] = vec3[](vec3(1.0, 0.25, 0.2), vec3(0.2, 0.9, 0.3), vec3(0.25, 0.45, 1.0), vec3(1.0, 0.9, 0.2));
            vec2 l = vec2(dot(P, shRight), dot(P, shUp));
            float dist = length(P - camPos);
            int c = 0;
            while (c < 3 && (dist > shRadius(c) || !shInWindow(c, l, 48))) c++;
            float t = c < 3 ? smoothstep(shRadius(c) * (1.0 - stdCascadeBlend), shRadius(c), dist) : 0.0;
            vec3 col = mix(cc[c], cc[min(c + 1, 3)], t) * (0.35 + 0.65 * shadow * ndl + 0.2);
            imageStore(outColor, pix, vec4(col, 1.0));
            return;
        }
        if (debugMode == DV_SHADOW) { imageStore(outColor, pix, vec4(vec3(shadow * ndl), 1.0)); return; }
        if (debugMode == DV_GI) { imageStore(outColor, pix, vec4(indirect * contact, 1.0)); return; }
        if (debugMode == DV_ALBEDO) { imageStore(outColor, pix, vec4(alb.rgb, 1.0)); return; }
        if (debugMode == DV_NORMALS) { imageStore(outColor, pix, vec4(N * 0.5 + 0.5, 1.0)); return; }
    }
#ifdef FOG_FROXEL
    vec4 fg = fogSample(froxelVol, posT.w, rd, camPos, pix, res, fogP, fogStart, vec2(hazeK, hazeSea));
#else
    vec4 fg = fogUpsample(fogTex, gbPos, pix, posT.w, res);
#endif
#if defined(FOG_FROXEL) && defined(WATER_CLEAR)
    if (!sky) {   // under water the froxels attenuate grey; the albedo already has the per-channel part
        vec4 wv = texelFetch(gbWater, pix, 0);
        if (wv.x > 0.0 && wv.y < 0.0) base *= waterFroxelFix(wv.z);
    }
#endif
    // clouds behind the weather fog (it hides them like the land), in front of the surface or of the sky
    vec4 cl = cloudComposite(cloudHalf, pix, res, camPos, rd, sky ? -1.0 : posT.w);
    vec3 outc = (base * cl.a + cl.rgb) * fg.a + fg.rgb;   // (the sky fades into the fog like the land)
    imageStore(outColor, pix, vec4(outc, 1.0));
}
