// Standard lighting: (re)trace a rectangle of one sun shadow cascade. One thread
// per texel: a ray from the plane above the world (z = shLzTop) along -sunDir
// through the world volume (distance field + atlas, world only); stores the
// light-space height of the first hit (the topmost occluder), or -1e30 if the
// line never hits anything (always lit). Texels are addressed toroidally by their
// ABSOLUTE light-space coordinate, so when the camera moves only the newly exposed
// strips are traced (LitRenderer::updateShadowRegions).

layout(local_size_x = 8, local_size_y = 8) in;

layout(r32f, SET(3) binding = 0) uniform writeonly image2D shadowMap;
layout(r16f, SET(3) binding = 1) uniform writeonly image2D shadowAux;

BEGIN_PASS_UNIFORMS
PASS_UNIFORMS_BODY
END_PASS_UNIFORMS

layout(push_constant) uniform PC {
    ivec2 u0;       // absolute light-space texel coords of the rect's corner
    ivec2 size;     // rect size (texels)
    int cascade;
    float texel;
} pc;

void main() {
    ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(g, pc.size))) return;
    ivec2 u = pc.u0 + g;
    vec2 l = (vec2(u) + 0.5) * pc.texel;
    // Start on the plane above the world (bounded: lzTop from the world's box). A streaming
    // world has no fixed box: start each line where it crosses the top of the world instead,
    // and store the hit's sun-axis coordinate the same way (start - t).
    float s0 = shLzTop;
    if (worldWin.w != 0) s0 = (float(worldBricks.y * 8 + 4) - (shRight.y * l.x + shUp.y * l.y)) / max(sunDir.y, 0.02);
    vec3 origin = shRight * l.x + shUp * l.y + sunDir * s0;
    Hit h = traceWorldShadow(origin, -sunDir, 1e30, kSkipMat);
    float occ = h.hit ? s0 - h.t : -1e30;
    // Hybrid sun shadows (optP.x): the lowest mantissa bit says the topmost occluder is foliage
    // (light gets through it: those columns are always traced). Off: the map is as it was.
    ivec2 t = ((u % shN) + shN) % shN;
    if (optP.x > 0.0 && h.hit) {
        bool leaf = materials[h.mat].props.z == 3.0;
        occ = uintBitsToFloat((floatBitsToUint(occ) & ~1u) | (leaf ? 1u : 0u));
        // Leaves on top: follow the column down the way sunVisibility follows a sun ray up -
        // each leaf voxel lets leafLight through, an opaque voxel / body / the 6th leaf / under
        // 3 % stops it. Below that depth everything is in full shadow (65000 = never).
        float block = 0.0;
        if (leaf) {
#ifdef FOLIAGE_LIGHT
            block = 65000.0;
            float T = 1.0;
            vec3 d = -sunDir, sd = mix(d, vec3(1e-6), lessThan(abs(d), vec3(1e-6)));
            Hit q = h;
            vec3 o = origin;
            float tq = h.t;   // distance of q from the top plane
            for (int k = 0; k < 6; k++) {
                if (materials[q.mat].props.z != 3.0 || lookP.w <= 0.0) { block = tq - h.t; break; }
                T *= lookP.w;
                if (T < 0.03 || k == 5) { block = tq - h.t; break; }
                vec3 p = o + d * q.t;
                vec3 tx = (vec3(q.cell) + step(vec3(0.0), sd) - p) / sd;
                float tExit = min(min(tx.x, tx.y), tx.z) + 1e-3;
                o = p + d * tExit;
                tq += tExit;
                q = traceWorldShadow(o, d, 1e30, kSkipMat);
                if (!q.hit) break;
                tq += q.t;
            }
#endif
        }
        imageStore(shadowAux, t + ivec2(0, pc.cascade * shN), vec4(min(block, 65000.0)));
    }
    imageStore(shadowMap, t + ivec2(0, pc.cascade * shN), vec4(occ));
}
